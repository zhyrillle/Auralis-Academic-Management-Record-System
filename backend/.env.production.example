# Auralis Backend Production Environment Variables
# Copy these values into your Render Web Service Environment settings:

PORT=5000
NODE_ENV=production

# Database Connection (Aiven Cloud MySQL)
# Copy your actual connection string from your local backend/.env file:
# Format: mysql://avnadmin:<password>@<host>:<port>/<dbname>?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-3ee9c17d-auralis.i.aivencloud.com:27935/defaultdb?ssl-mode=REQUIRED
DB_SSL=true

# Puppeteer Chromium binary in Docker container
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Cloudinary Storage (For Profile Pictures & Attachments)
# Copy credentials from your local backend/.env:
CLOUDINARY_CLOUD_NAME=hoxggpc3
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_URL=cloudinary://YOUR_KEY:YOUR_SECRET@hoxggpc3

# Nodemailer / Email Service (For OTP & Notifications)
# Copy credentials from your local backend/.env:
EMAIL_USER=thirdtdump3@gmail.com
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM="Auralis System <thirdtdump3@gmail.com>"
